#!/usr/bin/env bash
# Fetch-and-run shipyard — the shared plugin build tooling
# (github.com/chris-peterson/shipyard). Keeps a cached checkout at the `v1` ref,
# resyncs it to latest, and runs the requested command against this repo. No
# package install; shipyard's one dependency (pyyaml) must be importable
# (`pip install pyyaml` once, or the system package).
#
# Env overrides: SHIPYARD_REF (branch/tag, default v1), SHIPYARD_HOME
# (cache location).
set -euo pipefail

ref="${SHIPYARD_REF:-v1}"
cache="${SHIPYARD_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}/shipyard}"
repo="https://github.com/chris-peterson/shipyard.git"

# FETCH_HEAD rather than origin/$ref, so $ref may be a tag or a branch: shipyard
# publishes v1 as a tag, which has no remote-tracking branch, so origin/$ref
# resolves only on a cache old enough to predate the branch→tag switch — pinning
# it to whatever commit that stale ref still points at.
if [ -d "$cache/.git" ]; then
  git -C "$cache" fetch --quiet origin "$ref"
  git -C "$cache" reset --hard --quiet FETCH_HEAD
else
  git clone --quiet --branch "$ref" "$repo" "$cache"
fi

# shipyard resolves --root to the current directory, so run it from the repo root.
PYTHONPATH="$cache/src" exec python3 -m shipyard "$@"
